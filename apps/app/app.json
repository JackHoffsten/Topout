{
  "expo": {
    "name": "Topout",
    "slug": "topout",
    "scheme": "topout",
    "icon": "./assets/topout-ios-icon.png",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Topout to access a photo you choose to attach to a climb.",
          "cameraPermission": "Allow Topout to use your camera to take a photo for a climb.",
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Topout",
      "favicon": "./assets/topout-icon.png"
    },
    "android": {
      "package": "com.topout.app"
    },
    "ios": {
      "bundleIdentifier": "se.jackhoffsten.topout",
      "icon": "./assets/topout-ios-icon.png",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "28007dc8-d89e-4c32-b172-4f4d5e61538d"
      }
    },
    "owner": "jackhoffsten"
  }
}
