{
  "expo": {
    "name": "Topout",
    "slug": "topout",
    "scheme": "topout",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router", "expo-secure-store", "expo-status-bar", "expo-font"],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Topout",
      "favicon": "./assets/topout-icon.png"
    },
    "android": {
      "package": "com.topout.app"
    },
    "ios": {
      "bundleIdentifier": "com.topout.app",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
