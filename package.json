{
  "name": "topout",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @topout/app",
    "build": "npm run build --workspace @topout/app",
    "typecheck": "tsc -p tsconfig.tools.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm run test --workspace @topout/app",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "dotnet ef database update --project server/src/Topout.Infrastructure --startup-project server/src/Topout.Api",
    "api:dev": "dotnet run --project server/src/Topout.Api -- --environment Development --urls http://127.0.0.1:5080",
    "mobile": "npm run start --workspace @topout/app",
    "android": "npm run android --workspace @topout/app",
    "ios": "npm run ios --workspace @topout/app",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "expo": "57.0.24",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "caniuse-lite": "1.0.30001810",
    "prettier": "3.6.2",
    "selfsigned": "^5.5.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
